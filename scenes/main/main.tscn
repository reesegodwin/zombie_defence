[sub_resource type="Shader" id="glow_shader"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_disabled, shadows_disabled;
uniform float boost = 3.0;
void fragment() {
	ALBEDO = COLOR.rgb * boost;
	ALPHA = COLOR.a;
}
"

