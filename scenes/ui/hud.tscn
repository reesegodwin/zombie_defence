[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/hud.gd" id="hud"]
[ext_resource type="Script" path="res://scenes/ui/field.gd" id="field"]
[ext_resource type="Theme" path="res://scenes/ui/ui_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/slot.tscn" id="slot"]
[ext_resource type="PackedScene" path="res://scenes/ui/card.tscn" id="card"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("hud")
slot_scene = ExtResource("slot")
card_scene = ExtResource("card")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("theme")

[node name="Field" type="Control" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("field")

[node name="StatsPanel" type="PanelContainer" parent="Root"]
layout_mode = 1
offset_left = 16.0
offset_top = 16.0
offset_right = 316.0
offset_bottom = 150.0
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Root/StatsPanel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

