[node name="Panel" type="PanelContainer" parent="Root/TitleOverlay/Center/VBox"]
layout_mode = 2
size_flags_horizontal = 4

[node name="HowTo" type="Label" parent="Root/TitleOverlay/Center/VBox/Panel"]
layout_mode = 2
text = "Hold the left mouse button to shoot where you point.  F toggles auto-fire.
Your crew always fires on their own.
Kills give experience. Each level, pick one of three cards:
new guns, gear, traps, supplies, survivors, or a stronger wall.
I opens base storage: drag guns and gear onto your crew,
and drag traps onto the ground in front of the wall.
Right-drag or WASD pans, the wheel zooms, P pauses.
It only gets harder. A horde arrives every 70 seconds."

